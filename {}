        try:
            parsed = m.Api.StatusCodeValue(status_code=status_code)
        except c.ValidationError:
            return r[int].fail(
                f"Status code must be between 100 and 599 (RFC 7231): {status_code}",
            )
        return r[int].ok(parsed.status_code)


