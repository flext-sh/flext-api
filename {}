                    url=url_result.value,
                    method=method,
                    headers=connect_headers,
                    remaining=max_events - len(events),
                )
                events.extend(stream_events)
                if isinstance(next_retry, int) and next_retry >= 0:
                    retry_timeout_ms = next_retry
