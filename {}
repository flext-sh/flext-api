                if not auto_reconnect or attempts >= max_attempts:
                    break
                attempts += 1
                self._sleep_before_reconnect(retry_timeout_ms, attempts, backoff_factor)
            except (
                ValueError,
                TypeError,
                KeyError,
                httpx.HTTPError,
                ConnectionError,
