                if kwargs is not None and "json" in kwargs:
                    raw_json = kwargs["json"]
                    if raw_json is not None:
                        return r[FlextApiTypes.Api.RequestBody].ok(
                            FlextApiUtilities.Api.RequestUtils.to_request_body(
                                raw_json,
